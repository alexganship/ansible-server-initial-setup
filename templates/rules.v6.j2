# Generated by Ansible. Docker chains are intentionally not persisted here.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
:ANSIBLE_INPUT - [0:0]
-A INPUT -j ANSIBLE_INPUT
-A ANSIBLE_INPUT -i lo -j ACCEPT
-A ANSIBLE_INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A ANSIBLE_INPUT -p ipv6-icmp -j ACCEPT
-A ANSIBLE_INPUT -p udp --sport 547 --dport 546 -j ACCEPT
-A ANSIBLE_INPUT -p tcp --dport {{ ssh_port }} -m comment --comment ansible-managed-ssh-target -j ACCEPT
-A ANSIBLE_INPUT -j DROP
COMMIT
